# ============================================
# Research Search Engine - Environment Config
# ============================================

# OpenSearch
OPENSEARCH_NODE=https://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=your_secure_password
OPENSEARCH_INITIAL_ADMIN_PASSWORD=your_secure_password

# MongoDB
MONGODB_URI=mongodb://localhost:27017/research_db

# Redis
REDIS_URL=redis://localhost:6379
# Kerberos-filtered / inventor-scoped IP search TTL (seconds). IP_AUTHOR_SEARCH_CACHE_TTL is still read.
# IP_INVENTOR_SEARCH_CACHE_TTL=900

# Embedding Service
# transport: http (local dev) | grpc (production — Embed/Rerank via Envoy)
EMBEDDING_TRANSPORT=http
ENVOY_GRPC_TARGET=envoy:10000
EMBEDDING_SERVICE_URL=http://localhost:8001

# East-west gRPC listener (search.v1.SearchService)
GRPC_ENABLED=true
GRPC_BIND_ADDRESS=0.0.0.0:50053

# API Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Search pipeline (retrieve-then-rerank). CANDIDATE_K must match
# RERANK_MAX_CANDIDATES on the embedding service.
CANDIDATE_K=50
# Reranking takes BOTH sides: this flag only decides whether the API asks. The
# embedding service has its own RERANK_ENABLED and answers /rerank with 404
# {"detail":"Reranking is disabled"} when it is false, which the API survives by
# serving first-stage order. Set RERANK_ENABLED=true in services/embedding/.env
# too (that file is git-ignored, so a fresh checkout starts with it disabled).
RERANK_ENABLED=true
# 800ms is too tight for a CPU cross-encoder rerank batch and was silently
# falling back to first-stage ranking on every request; 15s gives real
# batches room to complete even on a slow model.
RERANK_TIMEOUT_MS=15000
# Which cross-encoder the embedding service loads. The API does not load it — it
# uses this string to namespace cached rerank scores (see RerankService.js), so it
# MUST be the exact value of RERANK_MODEL_NAME in services/embedding/.env or scores
# produced by one model get served as if they came from another. This is the local
# default; the containerised service in docker-compose.services.yml runs
# BAAI/bge-reranker-base.
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
# Only needed when the weights change but the model id does not (re-quantization,
# a fine-tune republished under the same name); it is appended to the cache namespace.
# RERANK_MODEL_REVISION=
RERANK_CACHE_TTL=3600
